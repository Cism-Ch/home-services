# ==============================================================================
# Base de Donnees & Supabase (PostgreSQL + Prisma)
# ==============================================================================
# URL avec connection pooling (Transaction mode - port 6543) pour Prisma Client
# Format: postgresql://[USER] : [PASSWORD] @ aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# URL directe PostgreSQL (Session mode - port 5432) pour Prisma Migrate
# Format: postgresql://[USER] : [PASSWORD] @ aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL=


# Supabase API (Client & Realtime)
NEXT_PUBLIC_SUPABASE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_ANON_KEY="http://localhost:3000"

# Supabase Service Role (Server-side uniquement - bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_ACCESS_TOKEN=
# ==============================================================================
# Authentification (Better-Auth)
# ==============================================================================
# Secret cryptographique pour signature des tokens et cookies (openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_API_KEY=

# URL de base de l'application
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=

# Fournisseurs OAuth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# Stockage d'Objets (Tigris - S3 compatible)
# ==============================================================================
TIGRIS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_ENDPOINT_URL_IAM=
AWS_REGION=

# ==============================================================================
# Performance & Cache (Upstash Redis)
# ==============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==============================================================================
# Files d'Attente & Webhooks (Upstash QStash)
# ==============================================================================
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ==============================================================================
# Emails Transactionnels (Resend)
# ==============================================================================
RESEND_API_KEY=
EMAIL_FROM=